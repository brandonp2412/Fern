  "fixed_sql": [
    {
      "name": "accounts",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"accounts\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"status\" TEXT NOT NULL, \"type\" TEXT NOT NULL, \"attributes\" TEXT NOT NULL, \"formatted_account\" TEXT NULL, \"connection_id\" TEXT NULL, \"connection_name\" TEXT NULL, \"connection_logo\" TEXT NULL, \"connection_type\" TEXT NULL, \"balance_current\" REAL NULL, \"balance_available\" REAL NULL, \"balance_limit\" REAL NULL, \"balance_overdrawn\" INTEGER NOT NULL DEFAULT 0 CHECK (\"balance_overdrawn\" IN (0, 1)), \"holder\" TEXT NULL, \"refreshed_balance\" TEXT NULL, \"refreshed_meta\" TEXT NULL, \"refreshed_transactions\" TEXT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "transactions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"transactions\" (\"id\" TEXT NOT NULL, \"account_id\" TEXT NOT NULL, \"connection_id\" TEXT NOT NULL, \"date\" TEXT NOT NULL, \"description\" TEXT NOT NULL, \"amount\" REAL NOT NULL, \"balance\" REAL NULL, \"type\" TEXT NOT NULL, \"merchant_name\" TEXT NULL, \"category_name\" TEXT NULL, \"category_group\" TEXT NULL, \"auto_category_name\" TEXT NULL, \"auto_category_group\" TEXT NULL, \"meta_logo\" TEXT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "category_overrides",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"category_overrides\" (\"transaction_id\" TEXT NOT NULL, \"category_name\" TEXT NOT NULL, \"category_group\" TEXT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"transaction_id\"));"
        }
      ]
    },
    {
      "name": "category_rules",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"category_rules\" (\"id\" TEXT NOT NULL, \"match_text\" TEXT NOT NULL, \"category_name\" TEXT NOT NULL, \"category_group\" TEXT NULL, \"created_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "image_rules",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"image_rules\" (\"id\" TEXT NOT NULL, \"match_text\" TEXT NOT NULL, \"exact\" INTEGER NOT NULL DEFAULT 1 CHECK (\"exact\" IN (0, 1)), \"image_path\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
